# Wiki Wall Street environment variables
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Every variable here is required by server/helper.py (Settings).

# --- App ---
# Base URL of the server (used to build password-reset links, etc.)
SERVER_URL=http://localhost:5000

# Flask secret key (any long, random string)
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# "local" disables the scheduler and scheduled portfolio updates
ENVIRONMENT=local

# --- MongoDB ---
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
USERS_DB_NAME=wikiwallstreet_users
GAMES_DB_NAME=wikiwallstreet_games
PLAYERS_DB_NAME=wikiwallstreet_players
TRANSACTIONS_DB_NAME=wikiwallstreet_transactions
CHATS_DB_NAME=wikiwallstreet_chats

# --- Wikipedia API ---
# Descriptive user agent per Wikimedia policy:
# https://meta.wikimedia.org/wiki/User-Agent_policy
WIKI_API_USER_AGENT=WikiWallStreet/1.0 (contact: your-email@example.com)

# Average daily project-wide pageviews for en.wikipedia (used to normalize article views)
EN_WIKI_AVERAGE_DAILY_PROJECT_VIEWS=249115652.14

# Hour (UTC, 0-23) at which pageview data updates once per day
UPDATE_HOUR_UTC=4

# --- Email (for password reset) ---
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
